# Copiá este archivo como .env y completá los valores.

# Conexión a Postgres. El usuario NO puede ser superusuario (los superusuarios
# saltean Row Level Security y se rompería el aislamiento entre facturistas).
DATABASE_URL=postgres://facturacion:cambiar_esta_clave@localhost:5432/facturacion

# Dirección desde la que se abre el sitio. En desarrollo es la de Vite.
APP_ORIGIN=http://localhost:5173

PORT=3000

# Cantidad de proxies delante del servidor (ej. 1 si el hosting pone un proxy HTTPS adelante).
# Dejalo en 0 si la app recibe las conexiones directo: si no, el límite de intentos de ingreso se puede saltear.
TRUST_PROXY=0

# "production" activa cookies seguras (solo HTTPS) y sirve el frontend compilado.
NODE_ENV=development
