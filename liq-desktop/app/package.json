{
  "name": "liquidacion-escritorio",
  "productName": "Liquidación",
  "version": "0.1.0",
  "private": true,
  "description": "Facturación de prestaciones por obra social. Los datos se guardan en la PC.",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json && node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "devDependencies": {
    "@fontsource/archivo": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.1",
    "esbuild": "0.28.2",
    "exceljs": "4.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vite": "6.4.6",
    "zod": "3.25.76"
  },
  "build": {
    "appId": "ar.liquidacion.escritorio",
    "productName": "Liquidación",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "linux": {
      "target": "AppImage",
      "category": "Office"
    },
    "directories": {
      "output": "release"
    }
  }
}
