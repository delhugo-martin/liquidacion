# Copiá este archivo como .env y completá los valores.

# Conexión a Postgres (base "liquidacion_nube"). Usá un usuario propio de la app, no el superusuario.
DATABASE_URL=postgres://liquidacion_nube:CAMBIAR_ESTA_CLAVE@localhost:5432/liquidacion_nube

PORT=3100

# Cantidad de proxies delante del servidor (ej. 1 si el hosting pone un proxy HTTPS adelante).
# Dejalo en 0 si la nube recibe las conexiones directo: si no, el límite de intentos de ingreso se puede saltear.
TRUST_PROXY=0
